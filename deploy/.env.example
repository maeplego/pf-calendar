# Postgres
CALENDAR_DATABASE_URL=postgres://calendar:calendar@calendar-db:5432/calendar

# API
CALENDAR_HTTP_PORT=8095
CALENDAR_DEV_AUTH=true
CALENDAR_CORS_ORIGIN=http://localhost:3005

# OIDC（P01 pf-identity と併用。web に OIDC_* を渡すとホストログイン必須）
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_AUDIENCE=pf-calendar-web
# CALENDAR_DEV_AUTH=false

# Web（サーバー → API は Docker ネットワーク、ブラウザ → API は localhost）
# CALENDAR_API_URL=http://calendar-api:8095
# NEXT_PUBLIC_CALENDAR_API_URL=http://localhost:8095

# リマインド worker（Mailhog UI: http://localhost:8025）
# CALENDAR_MAIL_FROM=calendar@localhost
# CALENDAR_REMINDER_POLL_SECONDS=60

# 内部 API（P10 等）
# CALENDAR_INTERNAL_TOKEN=dev-internal-token
# OIDC_CLIENT_ID=pf-calendar-web
# OIDC_REDIRECT_URI=http://localhost:3005/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3005/logged-out
